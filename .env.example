# Local shared demo. Docker Compose reads .env from the repository root.
FUTURE_YOU_DEMO=1
FUTURE_YOU_USER_ID=
WEB_PORT=3113
API_PORT=8113
MONGODB_DATABASE=prik_thai_dev

# Set your own local secret (at least 24 characters) for the operator dashboard.
AGENT_OPS_SECRET=

# Optional server-side OpenAI settings
OPENAI_API_KEY=
OPENAI_COMPANION_MODEL=
FUTURE_YOU_VOICE_ENABLED=0

# Optional hostname for a development preview.
DEV_PREVIEW_HOST=
